# backend/.env.production.example — Referencia completa de variables del backend en producción
#
# ⚠ SOLO REFERENCIA — en el deploy Docker estas variables las inyecta
#   docker-compose.prod.yml via el bloque environment:
#   El backend en contenedor NO lee este archivo; está excluido por .dockerignore.
#
# Para configurar el deploy Docker editar el .env en la RAÍZ del repo
# (copiado de .env.production.example en la raíz). Este archivo sirve para:
#   - Documentar qué variable controla qué
#   - Referencia si se despliega el backend fuera de Docker (uvicorn directo en servidor)
#
# En desarrollo local usar backend/.env (copiado de backend/.env.example).

PROJECT_NAME="Lore Master API"
ENVIRONMENT="production"
LOG_LEVEL=WARNING
ALLOWED_ORIGINS=["https://tu-dominio.com"]

# LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
# Prefijos excluidos del selector de modelos (modelos con thinking mode, etc.)
# OLLAMA_EXCLUDED_MODELS=["qwen3","deepseek-r1"]
MAX_TOKENS=2000
TEMPERATURE=0.7
MAX_CONCURRENT_LLM_CALLS=1
MAX_PENDING_CONTENTS=5

# Llama Guard — segunda capa semántica de moderación (fail-open: si falla, pasa)
# Activar en producción/demo. Requiere: ollama pull llama-guard3:8b (~4.9 GB, ~5 GB VRAM)
LLAMA_GUARD_ENABLED=true
LLAMA_GUARD_MODEL=llama-guard3:8b
LLAMA_GUARD_TIMEOUT=5.0

# Embedding
EMBEDDING_MODEL="paraphrase-multilingual-MiniLM-L12-v2"
EMBEDDING_DIMS=384

# RAG
CHUNK_SIZE=400
CHUNK_OVERLAP=150
TOP_K=4
RAG_SCORE_THRESHOLD=0.3
MAX_PDF_PAGES=100

# Vector DB — usar nombre del servicio Docker en deploy containerizado
QDRANT_URL=http://qdrant:6333

# JWT — REQUERIDA. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Guardar en secrets manager, no en disco.
SECRET_KEY=<REQUERIDA>
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Clerk — completar cuando se configure la cuenta
CLERK_JWKS_URL="https://your-org.clerk.accounts.dev/.well-known/jwks.json"
CLERK_AUDIENCE="your-audience-id"

# Cookies de sesión — HTTPS obligatorio en producción
COOKIE_SECURE=True
COOKIE_SAMESITE=Strict
COOKIE_ACCESS_NAME=access_token
COOKIE_CSRF_NAME=csrf_token
COOKIE_DOMAIN=               # dejar vacío para dominio actual; usar .ejemplo.com para subdominios
COOKIE_PATH=/

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_LLM_PER_MINUTE=5
RATE_LIMIT_IMAGE_PER_MINUTE=3

# Redis — usar nombre del servicio Docker en deploy containerizado
REDIS_URL=redis://redis:6379

# Image generation
IMAGE_PROMPT_MODEL=mistral:latest
IMAGE_PROMPT_TOKENS=512
IMAGE_BACKEND=comfyui
IMAGE_BATCH_SIZE_DEFAULT=4
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_SEED_BASE=42

# Storage
PROFILE_IMAGE_MAX_SIZE_MB=5
DOCUMENT_MAX_UPLOAD_MB=50
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=30
MEDIA_ROOT=./media

# Demo local — Floci como emulador S3 (red Docker interna)
# Nginx proxea /media/ → floci:4566/loremaster-media/ (bucket absorbido en proxy_pass)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://floci:4566
S3_BUCKET=loremaster-media
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# URL pública para image_url — mismo origen que el frontend vía Nginx
STORAGE_BASE_URL=http://localhost/media

# Producción real — reemplazar Floci por S3/R2
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://tu-endpoint-s3
# S3_BUCKET=tu-bucket
# AWS_ACCESS_KEY_ID=<via secrets manager>
# AWS_SECRET_ACCESS_KEY=<via secrets manager>
# STORAGE_BASE_URL=https://tu-dominio.com/media

# ComfyUI — ajustar a la IP/hostname del servidor con GPU
COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_TIMEOUT=300
COMFYUI_REQUEST_TIMEOUT=30.0

# Base de datos — PostgreSQL requerido en producción
# POSTGRES_USER, POSTGRES_PASSWORD y POSTGRES_DB: inyectar via secrets manager o CI/CD, no en disco.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_USER=<REQUERIDA>
POSTGRES_PASSWORD=<REQUERIDA>
POSTGRES_DB=loremaster