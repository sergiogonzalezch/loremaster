global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: loremaster
    static_configs:
      - targets: ["app:8000"]
    metrics_path: /metrics
    # El compose escribe el token desde METRICS_TOKEN en /run/metrics_token al iniciar.
    # No sustituir manualmente: definir METRICS_TOKEN en .env y levantar con docker compose.
    bearer_token_file: /tmp/metrics_token
