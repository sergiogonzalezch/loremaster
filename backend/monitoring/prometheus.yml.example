global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: loremaster
    static_configs:
      - targets: ["app:8000"]
    metrics_path: /metrics
    # Copiar este archivo como prometheus.yml y sustituir por el valor real.
    # El token debe coincidir con METRICS_TOKEN en .env / .env.production.
    bearer_token: "REPLACE_WITH_METRICS_TOKEN"
