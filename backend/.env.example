PROJECT_NAME="Lore Master API"
# local | production
ENVIRONMENT="local"
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR - production usar WARNING o ERROR
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
MAX_TOKENS=2000
TEMPERATURE=0.7

# Embedding
EMBEDDING_MODEL="paraphrase-multilingual-MiniLM-L12-v2"
EMBEDDING_DIMS=384

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=4
RAG_SCORE_THRESHOLD=0.3
MAX_PDF_PAGES=100  # Límite de páginas para PDFs (prevención de PDF bombs)

# Vector DB
QDRANT_URL=http://localhost:6333

# JWT — SECRET_KEY es REQUERIDA (no tiene valor por defecto).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Mínimo 32 caracteres en entornos no locales. No usar esta clave en producción.
SECRET_KEY=<reemplaza-con-clave-generada-min-32-chars>
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Clerk (production) - completar cuando configures Clerk
CLERK_JWKS_URL="https://your-org.clerk.accounts.dev/.well-known/jwks.json"
CLERK_AUDIENCE="your-audience-id"

# Storage (LocalStack dev)
# WARNING: No usar credenciales reales en este archivo.
# En producción, usar IAM roles o secrets manager en lugar de variables de entorno.
# STORAGE_BACKEND=localstack
# S3_ENDPOINT_URL=http://localstack:4566
# S3_BUCKET=loremaster-images
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Rate limiting (protección contra brute force)
RATE_LIMIT_PER_MINUTE=30  # Máximo de requests por minuto por IP

# Image generation
IMAGE_PROMPT_MODEL=mistral:latest  # Modelo para extracción de atributos visuales (independiente de OLLAMA_MODEL)
IMAGE_PROMPT_TOKENS=512            # Límite de tokens del prompt visual (max text encoder SD/Flux)
IMAGE_BACKEND=comfyui
IMAGE_BATCH_SIZE_DEFAULT=4
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_SEED_BASE=42

# Storage (local | s3 | r2)
PROFILE_IMAGE_MAX_SIZE_MB=5  # Tamaño máximo de avatar en MB
MEDIA_ROOT=./media
STORAGE_BACKEND=local
STORAGE_BASE_URL=http://localhost:8000/media

# ComfyUI
COMFYUI_URL=http://localhost:8188
COMFYUI_TIMEOUT=300          # segundos máximos para generar una imagen
COMFYUI_REQUEST_TIMEOUT=30.0 # timeout por request HTTP individual a ComfyUI

# ─── Base de datos ───────────────────────────────────────────────────────────
# COMPOSE_PROFILES controla qué servicios Docker arranca:
#   vacío (dev)        → solo qdrant + redis; la app usa SQLite (archivo local)
#   postgres (prod)    → además levanta el contenedor postgres
#
# Dev / local:
COMPOSE_PROFILES=
DATABASE_URL=sqlite:///./loremaster.db

# Producción (descomentar y completar — el perfil postgres requiere estas variables):
# COMPOSE_PROFILES=postgres
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}
# POSTGRES_USER=loremaster
# POSTGRES_PASSWORD=<generar-con: openssl rand -hex 16>
# POSTGRES_DB=loremaster
# ─────────────────────────────────────────────────────────────────────────────