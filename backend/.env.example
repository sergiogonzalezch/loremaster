PROJECT_NAME="Lore Master API"
# local | production
ENVIRONMENT="local"
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR - production usar WARNING o ERROR
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
# Prefijos excluidos del selector de modelos (modelos con thinking mode, etc.)
# OLLAMA_EXCLUDED_MODELS=["qwen3","deepseek-r1"]
TEMPERATURE=0.7
MAX_CONCURRENT_LLM_CALLS=1  # Semáforo de llamadas simultáneas a Ollama
MAX_PENDING_CONTENTS=5      # Máximo de contenidos pending por entidad/categoría

# Llama Guard — segunda capa semántica de moderación (fail-open: si falla, pasa)
# Requiere: ollama pull llama-guard3:8b (~4.9 GB, ~5 GB VRAM)
# Dejar false en desarrollo local. Activar en demo/producción.
LLAMA_GUARD_ENABLED=false
LLAMA_GUARD_MODEL=llama-guard3:8b
LLAMA_GUARD_TIMEOUT=5.0

# Embedding
EMBEDDING_MODEL="paraphrase-multilingual-MiniLM-L12-v2"
EMBEDDING_DIMS=384

# RAG
CHUNK_SIZE=400
CHUNK_OVERLAP=150
TOP_K=4
RAG_SCORE_THRESHOLD=0.3
MAX_PDF_PAGES=100  # Límite de páginas para PDFs (prevención de PDF bombs)

# Vector DB
QDRANT_URL=http://localhost:6333
# Reintentos al borrar vectores (útil en Qdrant lento o en red WAN)
# QDRANT_RETRY_ATTEMPTS=3
# QDRANT_RETRY_DELAY_SECONDS=0.5

# JWT — SECRET_KEY es REQUERIDA (no tiene valor por defecto).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Mínimo 32 caracteres en entornos no locales. No usar esta clave en producción.
SECRET_KEY=<reemplaza-con-clave-generada-min-32-chars>
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15   # corto por diseño; el refresh token renueva la sesión
REFRESH_TOKEN_EXPIRE_DAYS=7      # duración del refresh token (HttpOnly, path=/api/v1/auth/refresh)

# Clerk (production) - completar cuando configures Clerk
CLERK_JWKS_URL="https://your-org.clerk.accounts.dev/.well-known/jwks.json"
CLERK_AUDIENCE="your-audience-id"

# Cookies de sesión
# COOKIE_SECURE debe ser True en producción/demo (HTTPS obligatorio).
# En local puede ser False para desarrollo sin HTTPS.
COOKIE_SECURE=False          # ⚠ cambiar a True en producción
COOKIE_SAMESITE=Strict       # Strict | Lax | None
COOKIE_ACCESS_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token   # cookie HttpOnly restringida a /api/v1/auth/refresh
COOKIE_CSRF_NAME=csrf_token
COOKIE_DOMAIN=               # dejar vacío para dominio actual; usar .example.com para subdominios
COOKIE_PATH=/

# Rate limiting (protección contra brute force y DoS)
# false en desarrollo/eval para no chocar con los límites; true en demo/producción.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=30        # Límite base: requests por minuto por usuario/IP
RATE_LIMIT_LLM_PER_MINUTE=5    # Endpoints que invocan Ollama (query, build-prompt)
RATE_LIMIT_IMAGE_PER_MINUTE=3  # Endpoints de generación de imagen

# Redis — backend de rate limiting (sliding window por worker)
# En local el docker-compose levanta Redis en el puerto por defecto.
REDIS_URL=redis://localhost:6379

# Image generation
IMAGE_PROMPT_MODEL=mistral:latest  # Modelo para extracción de atributos visuales (independiente de OLLAMA_MODEL)
IMAGE_PROMPT_TOKENS=512            # Límite de tokens del prompt visual (max text encoder SD/Flux)
IMAGE_BACKEND=comfyui              # "comfyui" en local/demo/producción; "mock" exclusivo de tests unitarios (pytest)
IMAGE_BATCH_SIZE_DEFAULT=4
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_SEED_BASE=42

# Storage (local | s3)
PROFILE_IMAGE_MAX_SIZE_MB=5   # Tamaño máximo de avatar en MB
DOCUMENT_MAX_UPLOAD_MB=50     # Tamaño máximo de documentos subidos (PDF/TXT)
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=30  # Timeout en segundos para extraer texto (PDF/TXT)
# Duración máxima del SSE de documentos (segundos). Aumentar si los documentos tardan mucho en indexarse.
# DOCUMENT_EVENT_STREAM_MAX_SECONDS=300
MEDIA_ROOT=./media
STORAGE_BACKEND=local
STORAGE_BASE_URL=http://localhost:8000/media

# S3/Floci — solo aplica en el stack Docker (docker-compose.prod.yml).
# En ese modo el backend recibe estas variables inyectadas por el compose;
# no es necesario definirlas aquí. Ver .env.production.example en la raíz.

# ComfyUI
COMFYUI_URL=http://localhost:8188
COMFYUI_TIMEOUT=300          # segundos máximos para generar una imagen
COMFYUI_REQUEST_TIMEOUT=30.0 # timeout por request HTTP individual a ComfyUI
# Timeouts de health check y selector de modelos (subir en entornos con red lenta)
# HEALTH_CHECK_TIMEOUT_SECONDS=2.0
# OLLAMA_MODELS_TIMEOUT_SECONDS=5.0

# ─── Base de datos ───────────────────────────────────────────────────────────
# Modo SQLite (por defecto, sin Docker DB):
#   .\dev.ps1  /  make infra
DATABASE_URL=sqlite:///./loremaster.db

# SKIP_MIGRATIONS — solo para herramientas internas (evaluaciones).
# El script de eval inyecta esta variable cuando las migraciones ya se aplicaron
# en el proceso padre, evitando el deadlock SQLite + asyncio/greenlet en Windows.
# No definir en desarrollo ni producción.
# SKIP_MIGRATIONS=true

# Modo PostgreSQL (descomentar todo el bloque):
#   .\dev.ps1 -Postgres  /  make infra-pg
#   POSTGRES_USER, PASSWORD y DB son REQUERIDAS — docker-compose falla si no están definidas.
# DATABASE_URL=postgresql://loremaster:loremaster@localhost:5433/loremaster
# POSTGRES_USER=loremaster
# POSTGRES_PASSWORD=loremaster
# POSTGRES_DB=loremaster
# ─────────────────────────────────────────────────────────────────────────────