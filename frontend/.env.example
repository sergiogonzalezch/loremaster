# Copiar como .env para desarrollo local: cp .env.example .env
# Todas las VITE_* son públicas por diseño — Vite las hornea en el bundle del navegador.

VITE_API_BASE_URL=/api/v1

# Hostnames externos de media (S3, R2, CDN). Dejar vacío en dev.
# Ejemplo producción: VITE_MEDIA_HOST=pub-abc123.r2.dev,cdn.example.com
VITE_MEDIA_HOST=

# Clerk — publishable key (pk_test_/pk_live_), obtenerla del dashboard de Clerk.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_<publishable key de Clerk>