# .env.production.example — Variables de interpolación para docker-compose.prod.yml
#
# ─── PARA DOCKER COMPOSE EXCLUSIVAMENTE ──────────────────────────────────────
# Contiene solo las variables que docker-compose.prod.yml interpola con ${VAR}.
# El resto de la configuración del backend está hardcodeada en el bloque
# environment: del compose (QDRANT_URL, REDIS_URL, OLLAMA_BASE_URL, etc.).
#
# ─── USO ─────────────────────────────────────────────────────────────────────
# 1. Copiar como .env.production en la raíz del repo (junto al Makefile):
#      cp .env.production.example .env.production
# 2. Editar .env.production con los valores reales.
# 3. Levantar el stack:
#      make prod-up
# .env.production está en .gitignore — nunca se commitea.
# ─────────────────────────────────────────────────────────────────────────────
#
# Generar SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Generar contraseñas:
#   python -c "import secrets; print(secrets.token_hex(16))"

# ── Obligatorias (el compose falla si no están definidas) ─────────────────────

SECRET_KEY=<generar con secrets.token_hex(32) — mínimo 32 caracteres>

POSTGRES_USER=loremaster
POSTGRES_PASSWORD=<contraseña segura>
POSTGRES_DB=loremaster

# Orígenes CORS permitidos. En demo local: http://localhost
# En servidor con dominio: https://tu-dominio.com
# En producción real solo https://
ALLOWED_ORIGINS=http://localhost

# ── Opcionales (tienen valor por defecto en el compose) ───────────────────────

# URL pública para servir imágenes. El backend la usa para construir image_url.
# Demo local → http://localhost/media (Nginx proxea /media/ → Floci interno)
# Servidor con dominio → https://tu-dominio.com/media
STORAGE_BASE_URL=http://localhost/media

# Nombre del bucket S3/Floci. Cambiar si se usa un bucket diferente en S3/R2 real.
# S3_BUCKET=loremaster-media

# Llama Guard 3 — capa semántica de moderación (fail-open).
# Requiere: ollama pull llama-guard3:8b (~4.9 GB, ~5 GB VRAM).
# LLAMA_GUARD_ENABLED=false
# LLAMA_GUARD_MODEL=llama-guard3:8b
# LLAMA_GUARD_TIMEOUT=5.0

# ── Para producción real (no demo local) ──────────────────────────────────────

# Clerk — auth en producción. Descomentar cuando se complete la integración.
# CLERK_JWKS_URL=https://tu-tenant.clerk.accounts.dev/.well-known/jwks.json
# CLERK_AUDIENCE=tu-audience

# S3/R2 real — descomentar cuando se reemplace Floci por almacenamiento cloud.
# S3_ENDPOINT_URL=https://tu-endpoint-s3
# AWS_ACCESS_KEY_ID=tu-access-key
# AWS_SECRET_ACCESS_KEY=tu-secret-key