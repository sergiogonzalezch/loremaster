# .env.production.example — Variables de interpolación para docker-compose.prod.yml
#
# ─── PARA DOCKER COMPOSE EXCLUSIVAMENTE ──────────────────────────────────────
# Contiene solo las variables que docker-compose.prod.yml (y el overlay de
# monitoring) interpolan con ${VAR}. El resto de la configuración del backend
# está hardcodeada en el bloque environment: del compose (QDRANT_URL,
# REDIS_URL, OLLAMA_BASE_URL, etc.).
#
# ─── USO ─────────────────────────────────────────────────────────────────────
# 1. Copiar como .env.production en la raíz del repo (junto al Makefile):
#      cp .env.production.example .env.production
# 2. Editar .env.production con los valores reales.
# 3. Levantar el stack:
#      make prod-up
# .env.production está en .gitignore — nunca se commitea.
# ─────────────────────────────────────────────────────────────────────────────
#
# Generar SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Generar contraseñas:
#   python -c "import secrets; print(secrets.token_hex(16))"

# ── Obligatorias (el compose falla si no están definidas) ─────────────────────

SECRET_KEY=<generar con secrets.token_hex(32) — mínimo 32 caracteres>

POSTGRES_USER=loremaster
POSTGRES_PASSWORD=<contraseña segura>
POSTGRES_DB=loremaster

# Orígenes CORS permitidos — formato JSON array (Pydantic lo parsea como list[str]).
# Demo local:        ["http://localhost"]
# Servidor real:     ["https://tu-dominio.com"]
# Múltiples orígenes: ["https://app.com","https://www.app.com"]
ALLOWED_ORIGINS=["http://localhost"]

# Clerk — autenticación. El compose falla si no están definidas.
CLERK_JWKS_URL=https://tu-tenant.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=https://tu-dominio.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_<publishable key de Clerk>

# ── Opcionales (tienen valor por defecto en el compose) ───────────────────────

# URL pública para servir imágenes. El backend la usa para construir image_url.
# Demo local → http://localhost/media (Nginx proxea /media/ → Floci interno)
# Servidor con dominio → https://tu-dominio.com/media
# R2 con dominio público → https://pub-abc123.r2.dev
STORAGE_BASE_URL=http://localhost/media

# Hostnames externos de media para el frontend (S3, R2, CDN). Vacío = solo mismo origen.
# VITE_MEDIA_HOST=pub-abc123.r2.dev

# Bucket y región S3/Floci. Cambiar si se usa un bucket diferente en S3/R2 real.
# S3_BUCKET=loremaster-media
# S3_REGION=us-east-1

# Backend de generación de imágenes: comfyui (defecto) | runpod
# IMAGE_BACKEND=comfyui

# Modelos de Ollama (corren en el host, fuera de Docker)
# OLLAMA_MODEL=llama3.2:latest
# IMAGE_PROMPT_MODEL=mistral:latest

# Rate limiting — false por defecto. Activar cuando haya usuarios reales.
# RATE_LIMIT_ENABLED=true

# Llama Guard 3 — capa semántica de moderación (fail-open).
# Requiere: ollama pull llama-guard3:8b (~4.9 GB, ~5 GB VRAM).
# LLAMA_GUARD_ENABLED=false
# LLAMA_GUARD_MODEL=llama-guard3:8b
# LLAMA_GUARD_TIMEOUT=5.0

# Monitoring (docker-compose.monitoring.yml) — Prometheus + Grafana.
# METRICS_TOKEN debe coincidir con bearer_token en backend/monitoring/prometheus.yml.
# Se inyecta tanto al backend (app) como a Prometheus; cambiar en producción real.
# METRICS_TOKEN=dev-metrics-token
# GF_ADMIN_USER=admin
# GF_ADMIN_PASSWORD=<contraseña segura>

# ── S3/R2 real (no demo local) ─────────────────────────────────────────────────
# Sin definir, el compose usa Floci interno (S3_ENDPOINT_URL=http://floci:4566,
# credenciales "test"). Para Cloudflare R2 / AWS S3 real, definir:
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=<via secrets manager>
# AWS_SECRET_ACCESS_KEY=<via secrets manager>
